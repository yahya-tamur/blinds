					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "Espressif ESP32-S3-DevKitC-1 v1.1 dev board, N16R8 (16 MB flash, 8 MB octal PSRAM). Pins 1-22 = header J1 pins 1-22, pins 23-44 = header J3 pins 1-22. Two 1x22 2.54 mm headers, rows 25.4 mm (1.0 in) apart (measured from photos of the clone). Antenna overhangs ~6 mm past the top board edge; both USB-C ports are on the bottom edge. GPIO35/36/37 are used by the octal PSRAM; GPIO19/20 = native USB; GPIO0/3/45/46 = strapping; RGB LED on GPIO38 (v1.1)"
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "a6512966-e999-41ef-b968-e256464a4d2f")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)

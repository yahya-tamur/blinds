					(size 1.27 1.27)
				)
				(justify left)
			)
		)
		(property "Footprint" "carrier:ESP32-S3-DevKitC-1_Soldered"
			(at 360.68 80.01 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Datasheet" "https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s3/esp32-s3-devkitc-1/user_guide_v1.1.html"
			(at 360.68 80.01 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "Espressif ESP32-S3-DevKitC-1 v1.1 dev board, N16R8 (16 MB flash, 8 MB octal PSRAM). Pins 1-22 = header J1 pins 1-22, pins 23-44 = header J3 pins 1-22. Two 1x22 2.54 mm headers, rows 25.4 mm (1.0 in) apart (measured from photos of the clone). Antenna overhangs ~6 mm past the top board edge; both USB-C ports are on the bottom edge. GPIO35/36/37 are used by the octal PSRAM; GPIO19/20 = native USB; GPIO0/3/45/46 = strapping; RGB LED on GPIO38 (v1.1)"
			(at 360.68 80.01 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "MPN" "ESP32-S3-DevKitC-1-N16R8"
			(at 360.68 80.01 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Notes" "Soldered straight to the board on its own pins. Its 3V3 pin (~500 mA LDO) powers all 3.3 V logic. GPIO21 (pin 40) switches the motor relay"
			(at 360.68 80.01 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)

				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Notes" "Soldered straight to the board on its own pins. MS1=MS2=GND -> UART address 0. CLK=GND -> internal clock. UART on RX (pin 4)"
			(at 463.55 59.69 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)

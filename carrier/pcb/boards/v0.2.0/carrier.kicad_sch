		(property "Description" "BIGTREETECH TMC2209 V1.3 StepStick driver module, VS 4.75-28 V, 2 A RMS. Two 1x8 2.54 mm rows 12.7 mm apart; top edge (in line with EN/VS): INDEX pin 2.54 mm and DIAG pin 5.08 mm in from the left row, VREF hole between them (unused)"
			(at 463.55 59.69 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
